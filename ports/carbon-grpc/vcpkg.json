{
  "name": "carbon-grpc",
  "version": "1.2.0",
  "description": "Provides base functionality for project specific gRPC modules.",
  "supports": "(windows & x64) | osx | linux",
  "dependencies": [
    {
      "name": "carbon-core",
      "version>=": "3.3.0#1"
    },
    {
      "name": "carbon-prometheus",
      "version>=": "4.2.0"
    },
    {
      "name": "grpc",
      "version>=": "1.81.1"
    },
    {
      "name": "protobuf",
      "features": [
        "pyext"
      ],
      "version>=": "6.33.4"
    },
    {
      "name": "python3",
      "version>=": "3.12.16"
    },
    {
      "name": "vcpkg-cmake",
      "host": true,
      "version>=": "2024-04-23"
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true,
      "version>=": "2024-05-23"
    }
  ]
}
